{
  "manifest_version": 3,
  "name": "Управление сетевыми запросами",
  "version": "1.0",
  "minimum_chrome_version": "111",
  "description": "Блокировка и подмена сетевых запросов",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Управление запросами",
    "default_icon":{
      "16": "icons/lock-16.png",
      "32": "icons/lock-32.png",
      "48": "icons/lock-48.png",
      "128": "icons/lock-128.png"
    }
  },
  "icons": {
    "16": "icons/lock-16.png",
    "32": "icons/lock-32.png",
    "48": "icons/lock-48.png",
    "128": "icons/lock-128.png"
  }
}